      "regulation_id": "BWBR0008498",
      "effective_date": "2023-01-01",
      "publication_id": "stb-2022-501",
      "short_label": "ARIE herziening",
      "focus_article": "2.5",
      "context": "Hoofdstuk 2 · afdeling 2",
      "summary": "Nieuwe opzet van de ARIE-regeling voor zware ongevallen met gevaarlijke stoffen: aanwijssystematiek, verplichtingen en handhaving.",
      "detail": "De herziening omvat onder meer de aanwijssystematiek, het preventiebeleid en de aanvullende RI&E, het veiligheidsbeheerssysteem, het intern noodplan, deskundige bijstand en meldingen. Dezelfde ingangsdatum bevat ook een afzonderlijke wijziging voor de politie. Voor bepaalde bedrijven geldt overgangsrecht; de bronpublicatie bevat de voorwaarden.",
      "source_urls": [
        "https://zoek.officielebekendmakingen.nl/stb-2022-501.html",
        "https://www.arboportaal.nl/onderwerpen/werken-met-gevaarlijke-stoffen/arie/wat-zegt-de-wet"
      ]
    },
    {
      "regulation_id": "BWBR0008498",
      "effective_date": "2024-01-01",
      "publication_id": "stb-2022-501",
      "short_label": "ARIE en Omgevingswet",
      "focus_article": "2.4",
      "context": "Hoofdstuk 2 · afdeling 2",
      "summary": "Volgende ingangsdatum met ARIE-bepalingen en aansluiting op de Omgevingswet. Zie de betrokken artikelen voor de afzonderlijke wijzigingen."
    }
  ]
